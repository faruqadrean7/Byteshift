# ============================================================================
# Byteshift Studio — Environment Variables
# Copy file ini menjadi .env.local dan isi dengan konfigurasi Anda
# ============================================================================

# 1. Neon DB Connection String (Dapatkan dari Neon Console -> Connection String)
# Contoh: postgresql://neondb_owner:npg_xxxx@ep-soft-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Secret Key untuk Autentikasi Admin Session (Acak, minimal 32 karakter)
# WAJIB diisi di production — tanpa ini aplikasi menolak memproses sesi admin.
# Generate: openssl rand -base64 48
AUTH_SECRET="byteshift-super-secret-key-change-this-in-production-12345"

# 3. Kredensial Admin Default (Digunakan saat menjalankan `npm run db:init`)
ADMIN_EMAIL="admin@byteshift.id"
ADMIN_PASSWORD="admin123"

# 4. URL Website Publik
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 5. WhatsApp Official
NEXT_PUBLIC_WA_NUMBER="6282210810793"

# 6. Resend Email Notifications (Opsional, untuk notifikasi lead via email)
# RESEND_API_KEY="re_xxxx"
# LEAD_NOTIFY_EMAIL="info@byteshift.id"
# LEAD_FROM_EMAIL="onboarding@resend.dev"

# 7. Neon Object Storage (Opsional — untuk simpan foto upload agar persisten/aman)
# Ambil kredensial dari Neon Console -> Object Storage, atau `neon env pull`.
# Jika KOSONG, upload otomatis fallback ke disk lokal (public/uploads).
# Bucket harus mode "public_read" agar foto bisa dilihat pengunjung.
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_ENDPOINT_URL_S3="https://<project>.s3.<region>.neon.tech"
# AWS_REGION="us-east-2"
# STORAGE_BUCKET="uploads"
